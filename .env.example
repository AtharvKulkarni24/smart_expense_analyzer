# ========================================================
# SpendSense: Root Environment Variables Template
# Copy this file to .env and configure for your local environment
# ========================================================

# PostgreSQL Docker Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=spendsense_db
POSTGRES_PORT=5432

# Backend Environment (Express)
PORT=5001
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
JWT_SECRET=spendsense_super_secret_jwt_key_change_in_production
NODE_ENV=development

# Internal ML Microservice Gateway Connection
ML_SERVICE_URL=http://localhost:8000

# ML Microservice Configuration (FastAPI)
ML_PORT=8000
ML_HOST=0.0.0.0
MODEL_VERSION=1.0.0
CLASSIFIER_PATH=models/classifier_v1.joblib
KMEANS_PATH=models/kmeans_v1.joblib

# Frontend Configuration (Vite)
VITE_API_BASE_URL="http://localhost:5001/api/v1"
